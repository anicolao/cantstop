# Real Firebase client configuration. Without it, bun run dev starts isolated
# anonymous Auth + Firestore + DiceTower input emulators (Java 21 required).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false
VITE_PREVIEW_ID=local
PUBLIC_BASE_PATH=/
